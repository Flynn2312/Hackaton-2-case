# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://your-project-ref.supabase.co
# Публичный ключ (sb_publishable_...) — бэкенду не нужен, может пригодиться фронту
SUPABASE_KEY=sb_publishable_your-key
# Секретный ключ (sb_secret_...) — им работает бэкенд. Никогда не отдавать на фронт
SUPABASE_SECRET_KEY=sb_secret_your-key

# CORS: адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Postgres (Project Settings -> Database -> Connection string, пулер)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Генератор живых данных завода. Локально ставьте false, чтобы не перехватывать генерацию у задеплоенного бэкенда
SIMULATOR_ENABLED=true

# Claude API: варианты решения инцидентов (console.anthropic.com -> API Keys). Без ключа — резервный алгоритм
ANTHROPIC_API_KEY=sk-ant-your-key
