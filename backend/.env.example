# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://your-project-ref.supabase.co
# Публичный ключ (sb_publishable_...) — бэкенду не нужен, может пригодиться фронту
SUPABASE_KEY=sb_publishable_your-key
# Секретный ключ (sb_secret_...) — им работает бэкенд. Никогда не отдавать на фронт
SUPABASE_SECRET_KEY=sb_secret_your-key

# CORS: адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
